# ---- Hostnames (sslip.io maps them to the VM IP) ----
APP_HOST=app.<IP>.sslip.io
DEMO_HOST=demo.<IP>.sslip.io

# ---- api ----
PORT=4000
CORS_ORIGIN=

# ---- AI: Vultr Serverless Inference. Model choice: docs/kan-21-ai-model.md ----
LLM_PROVIDER=vultr
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_API_KEY=
LLM_MODEL=glm-5.3
# Leave the vision model empty: the visual check is Stretch and is off in Core.
LLM_VISION_MODEL=
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=60000

# ---- Internal auth between api and egress-proxy (openssl rand -hex 32) ----
INTERNAL_TOKEN=

# ---- Sandbox ----
PROXY_ADMIN_URL=http://egress-proxy:8080
SANDBOX_PROXY_URL=http://172.30.0.10:3128
SANDBOX_IMAGE=shipcheck-sandbox:latest
SANDBOX_NETWORK=shipcheck-sandbox
SANDBOX_RUNTIME=runsc

# ---- Limits (v2) ----
MAX_PAGES=12
MAX_JOURNEYS=5
MAX_ACTIONS_PER_JOURNEY=12
MAX_ACTIONS_PER_AUDIT=40
MAX_CANDIDATES=50
MAX_LINKS_PER_PAGE=30
PAGE_TIMEOUT_MS=20000
ACTION_TIMEOUT_MS=15000
DISCOVER_TIMEOUT_MS=60000
# A slow site spends the explore budget on its journeys and leaves planned pages
# unaudited ("exceeded its time limit"), so this ceiling is 10 minutes. It is a ceiling,
# not a duration: a fast site still finishes in a few minutes.
EXPLORE_TIMEOUT_MS=600000
VERIFY_TIMEOUT_MS=240000
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_PER_HOUR=5

# ---- Storage ----
DATA_DIR=/data
STORAGE_DRIVER=s3
S3_HOSTNAME=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
